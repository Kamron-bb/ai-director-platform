# ── Application ─────────────────────────────
APP_ENV=local
API_PORT=8000

# ── PostgreSQL (users, roles, settings) ─────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_director
POSTGRES_USER=ai_director
POSTGRES_PASSWORD=change_me

# ── ClickHouse (analytics) ──────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me

# Отдельный пользователь для AI: только SELECT по mart_*
CLICKHOUSE_AI_USER=ai_readonly
CLICKHOUSE_AI_PASSWORD=change_me

# ── Auth ────────────────────────────────────
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Director ─────────────────────────────
# Вызывается ТОЛЬКО с бэкенда. В браузер не передаётся.
ANTHROPIC_API_KEY=

# ── Frontend ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
